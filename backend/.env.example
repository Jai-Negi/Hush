# Copy to backend/.env and fill in. Never commit .env.

# Neon Postgres connection string (Dashboard -> Connect -> psycopg).
# Optional: without it the API falls back to the live feed / bundled snapshot.
DATABASE_URL=

# OpenRouteService API key (free at https://account.heigit.org — no card).
# Required for live routing; without it only the baked fallback pair works.
ORS_API_KEY=

# Comma-separated allowed frontend origins. "*" (default) allows all.
# Example: https://hush.onrender.com,http://localhost:5173
CORS_ORIGINS=*
